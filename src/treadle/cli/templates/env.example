# Copy this file to .env and fill in real values. Never commit .env.
# Treadle treats every value in .env as a secret and masks it in logs.
# TREADLE_TOKEN=<at least 32 random characters, for example from: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
# NTFY_URL=https://ntfy.sh/<your-topic>
# BLOG_HOOK_SECRET=<at least 16 random characters>
